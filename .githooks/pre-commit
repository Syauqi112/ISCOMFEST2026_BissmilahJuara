#!/bin/sh
# Pengingat docs (tidak memblokir). Aktifkan: git config core.hooksPath .githooks
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0
code=$(printf '%s\n' "$staged" | grep -v -E '^docs/|\.md$|^\.githooks/|^\.github/' | head -1)
[ -z "$code" ] && exit 0
if ! printf '%s\n' "$staged" | grep -q '^docs/PROGRESS.md$'; then
  echo "" >&2
  echo "[docs] Kode berubah tapi docs/PROGRESS.md tidak ikut di-commit." >&2
  echo "[docs] Kalau ini fitur/perbaikan penting, tambah 1 baris di PROGRESS.md (lihat tabel di AGENTS.md)." >&2
  echo "" >&2
fi
exit 0
